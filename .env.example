# Copy to .env.local and fill in real values. Never commit .env.local.

# App config
# Sets the demo base currency until per-user base currency lands with auth (Phase 2).
DEFAULT_BASE_CURRENCY=USD

# Database
MONGODB_URI=

# OpenAI — AI category suggestion (gpt-4o-mini, FR-19/FR-20)
OPENAI_API_KEY=

# NextAuth — generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Sentry error tracking (optional in dev)
SENTRY_DSN=

# Upstash Redis — rate limiting (NFR-5). Without these the limiter falls back
# to an in-memory map (dev only; not safe across serverless instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Exchange rates (phase 3) — exchangerate.host
EXCHANGERATE_API_BASE=https://api.exchangerate.host

# Stripe billing (phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend transactional email (password reset, phase 2).
# Without RESEND_API_KEY the reset flow logs the link instead of emailing (dev).
RESEND_API_KEY=
RESEND_FROM=Daily Expenses <onboarding@resend.dev>

# AWS Textract OCR (phase 4)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-central-1

# Cloudinary receipt storage (phase 4). Find these on the Cloudinary dashboard.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name> works too —
# if set, the SDK reads it automatically and the three fields below can be blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder to upload receipts into (kept namespaced per-env).
CLOUDINARY_RECEIPTS_FOLDER=daily-expenses/receipts
