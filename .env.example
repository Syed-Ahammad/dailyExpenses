# Copy to .env.local and fill in real values. Never commit .env.local.

# App config
# Sets the demo base currency until per-user base currency lands with auth (Phase 2).
DEFAULT_BASE_CURRENCY=USD

# Database
MONGODB_URI=

# Anthropic Claude (Haiku) — AI category suggestion
ANTHROPIC_API_KEY=

# NextAuth — generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Sentry error tracking (optional in dev)
SENTRY_DSN=

# Exchange rates (phase 3) — exchangerate.host
EXCHANGERATE_API_BASE=https://api.exchangerate.host

# Stripe billing (phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend transactional email (password reset, phase 2).
# Without RESEND_API_KEY the reset flow logs the link instead of emailing (dev).
RESEND_API_KEY=
RESEND_FROM=Daily Expenses <onboarding@resend.dev>

# AWS Textract OCR (phase 4)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-central-1
