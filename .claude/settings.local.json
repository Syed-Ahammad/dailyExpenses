{
  "permissions": {
    "allow": [
      "Bash(claude mcp *)",
      "mcp__playwright__browser_navigate",
      "Bash(taskkill /F /IM node.exe)",
      "Bash(echo \"Exit: $?\")",
      "Bash(npm run *)",
      "Bash(echo \"PID=$!\")",
      "Read(//tmp/**)",
      "Bash(curl -s -o /dev/null -w \"port 3000: %{http_code}\\\\n\" http://localhost:3000)",
      "Bash(curl -s -o /dev/null -w \"port 3004: %{http_code}\\\\n\" http://localhost:3004)",
      "Bash(fuser -k 3004/tcp)",
      "Bash(fuser -k 3000/tcp)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" --connect-timeout 1 http://localhost:3000)",
      "Bash(xargs kill -9)",
      "Bash(netstat -tlnp)",
      "Bash(curl -v --connect-timeout 2 http://localhost:3000)",
      "Bash(curl -s http://localhost:3000/dashboard)",
      "Bash(curl -s -L http://localhost:3000/dashboard)",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_evaluate",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" \"http://localhost:3000/_next/static/chunks/app/dashboard/page.js\")",
      "Bash(PORT=3004 npm run dev -- --port 3004)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" \"http://localhost:3004/_next/static/chunks/app/dashboard/page.js\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" \"http://localhost:3004/dashboard\")",
      "Bash(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 1 http://localhost:__TRACKED_VAR__/_next/static/chunks/app/dashboard/page.js)",
      "Bash(awk '{print $2}')"
    ]
  }
}
